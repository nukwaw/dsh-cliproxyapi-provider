{
  "name": "@router-for-me/dsh-cliproxyapi-provider",
  "version": "0.3.2",
  "description": "GUI-configurable CLIProxyAPI Responses provider for DeepSeek Harness, with Fast mode and server-side web search",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./catalog": "./src/catalog.js",
    "./settings-contract": "./src/settings-contract.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/catalog.js && node --check src/provider.js && node --check src/settings-contract.js && node --check client.js && node --test",
    "pack:github": "npm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/router-for-me/dsh-cliproxyapi-provider.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.85.1",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": true
}
